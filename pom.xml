<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!-- Naming, deliberately two-tier: the repository, artifact and CLI name are the short
         file-copy-util; the GUI window shows the longer product title "File Verifier & Copier"
         (see FileVerifierFrame.setTitle). Package and groupId stay com.fileverifier to match the code. -->
    <groupId>com.fileverifier</groupId>
    <artifactId>file-copy-util</artifactId>
    <version>1.2.1</version>
    <packaging>jar</packaging>

    <name>File Copy Util</name>
    <description>Copy and verify files between directories using rsync and SHA-256 hashes</description>
    <url>https://github.com/moontato/file-copy-util</url>

    <scm>
        <url>https://github.com/moontato/file-copy-util</url>
        <connection>scm:git:https://github.com/moontato/file-copy-util.git</connection>
        <developerConnection>scm:git:ssh://git@github.com/moontato/file-copy-util.git</developerConnection>
    </scm>

    <!-- MIT: permissive, and it keeps every future option open (MIT code can be re-released under
         GPL later; the reverse needs every contributor's consent). Text in LICENSE. -->
    <licenses>
        <license>
            <name>MIT License</name>
            <url>https://opensource.org/license/mit/</url>
            <distribution>repo</distribution>
        </license>
    </licenses>

    <properties>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <maven.compiler.release>17</maven.compiler.release>
        <junit.version>5.10.2</junit.version>
        <flatlaf.version>3.7.2</flatlaf.version>
    </properties>

    <dependencies>
        <!-- The GUI's look and feel. Swing's default look and feel cannot be modernised by recolouring:
             colours and spacing are adjustable, widget shapes are not. The engine has no dependency; only
             the GUI front end needs this one, and the runnable jar shades it so `java -jar` still works. -->
        <dependency>
            <groupId>com.formdev</groupId>
            <artifactId>flatlaf</artifactId>
            <version>${flatlaf.version}</version>
        </dependency>

        <!-- Compile-time only: tells the static analysis when a finding is deliberate rather than a
             bug. Provided scope keeps it out of the jar, which still has no runtime dependency. -->
        <dependency>
            <groupId>com.github.spotbugs</groupId>
            <artifactId>spotbugs-annotations</artifactId>
            <version>4.8.3</version>
            <scope>provided</scope>
        </dependency>

        <!-- Test-only. There is no runtime dependency, so no shading is needed and the jar is the jar. -->
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <version>${junit.version}</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.13.0</version>
                <configuration>
                    <!-- <release> compiles against the JDK 17 API and rejects newer API usage;
                         source/target alone would not. -->
                    <release>17</release>
                    <compilerArgs>
                        <!-- 5.7: the compiler is the free static analysis. -Werror means a warning cannot
                             be parked for later; it has to be fixed or explicitly silenced where it is
                             wrong. -->
                        <arg>-Xlint:all</arg>
                        <arg>-Werror</arg>
                    </compilerArgs>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>3.2.5</version>
            </plugin>
            <plugin>
                <!-- 5.7: bytecode-level analysis on every build, at the level where style complaints
                     also show up, because the codebase is clean at it and there is no reason to accept
                     the next finding that arrives. Findings it raised and what was done about them are
                     recorded in CHANGELOG 1.1.0. -->
                <groupId>com.github.spotbugs</groupId>
                <artifactId>spotbugs-maven-plugin</artifactId>
                <version>4.8.3.0</version>
                <executions>
                    <execution>
                        <id>spotbugs</id>
                        <phase>verify</phase>
                        <goals>
                            <goal>check</goal>
                        </goals>
                    </execution>
                </executions>
                <configuration>
                    <threshold>Medium</threshold>
                    <failOnError>true</failOnError>
                </configuration>
            </plugin>
            <plugin>
                <!-- The jar must stay runnable with a bare `java -jar`, so the look and feel is packed
                     into it. Shade replaces the plain jar rather than producing a second artifact, so
                     CI, the release workflow and the README all keep naming one file. -->
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-shade-plugin</artifactId>
                <version>3.5.2</version>
                <executions>
                    <execution>
                        <phase>package</phase>
                        <goals>
                            <goal>shade</goal>
                        </goals>
                        <configuration>
                            <createDependencyReducedPom>false</createDependencyReducedPom>
                            <shadedArtifactAttached>false</shadedArtifactAttached>
                            <transformers>
                                <transformer implementation="org.apache.maven.plugins.shade.resource.ManifestResourceTransformer">
                                    <mainClass>com.fileverifier.FileVerifierApp</mainClass>
                                </transformer>
                            </transformers>
                            <filters>
                                <filter>
                                    <artifact>*:*</artifact>
                                    <excludes>
                                        <exclude>META-INF/*.SF</exclude>
                                        <exclude>META-INF/*.DSA</exclude>
                                        <exclude>META-INF/*.RSA</exclude>
                                        <exclude>module-info.class</exclude>
                                    </excludes>
                                </filter>
                            </filters>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-jar-plugin</artifactId>
                <version>3.3.0</version>
                <configuration>
                    <archive>
                        <manifest>
                            <mainClass>com.fileverifier.FileVerifierApp</mainClass>
                        </manifest>
                    </archive>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
